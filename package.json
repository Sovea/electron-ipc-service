{
  "name": "@sovea/electron-ipc-service",
  "author": "Sovea",
  "version": "0.1.0",
  "description": "Type-safe request-response IPC services for Electron main and renderer processes.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.15.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    },
    "./renderer": {
      "types": "./esm/renderer.d.ts",
      "import": "./esm/renderer.js"
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "rslib build",
    "check": "biome check --write",
    "check:ci": "biome check --diagnostic-level=error biome.json package.json pnpm-workspace.yaml playwright.config.ts rslib.config.ts tsconfig.json tsconfig.e2e.json tsconfig.type-tests.json tsconfig.type-tests.nodenext.json scripts e2e src type-tests",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "pack:check": "node scripts/check-package.mjs",
    "prepack": "pnpm run build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:current": "node scripts/run-e2e.mjs --electron current",
    "test:e2e:install-deps": "bash scripts/install-e2e-deps-linux.sh",
    "test:e2e:runner": "node --test scripts/e2e/*.test.mjs",
    "test:e2e:stress": "node scripts/run-e2e.mjs --electron current --stress",
    "test:e2e:types": "tsc -p tsconfig.e2e.json",
    "test:package": "pnpm run pack:check && publint && attw --pack --profile esm-only . --entrypoints . ./renderer",
    "test:types": "rslib build && tsc -p tsconfig.type-tests.json && tsc -p tsconfig.type-tests.nodenext.json"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "ipc",
    "typescript",
    "type-safe",
    "main-process",
    "renderer-process"
  ],
  "homepage": "https://github.com/Sovea/electron-ipc-service#readme",
  "bugs": {
    "url": "https://github.com/Sovea/electron-ipc-service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovea/electron-ipc-service.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "dependencies": {
    "nanoid": "^6.0.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@rslib/core": "^0.23.2",
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^26.1.1",
    "electron": "43.2.0",
    "publint": "0.3.22",
    "typescript": "^7.0.2",
    "vite": "8.1.5",
    "vite-plugin-electron": "1.1.0"
  },
  "peerDependencies": {
    "electron": ">=28.0.0"
  }
}
