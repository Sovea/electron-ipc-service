{
  "name": "@sovea/electron-ipc-service",
  "author": "Sovea",
  "version": "0.1.0",
  "description": "Type-safe request-response IPC services for Electron main and renderer processes.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "import": "./esm/index.js"
    },
    "./*": {
      "types": "./esm/*.d.ts",
      "import": "./esm/*.js"
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "rslib build",
    "check": "biome check --write",
    "check:ci": "biome check --diagnostic-level=error package.json playwright.config.ts tsconfig.e2e.json scripts e2e src/core/main.ts src/core/renderer.ts",
    "dev": "rslib build --watch",
    "format": "biome format --write",
    "pack:check": "npm pack --dry-run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:current": "node scripts/run-e2e.mjs --electron current",
    "test:e2e:install-deps": "bash scripts/install-e2e-deps-linux.sh",
    "test:e2e:runner": "node --test scripts/e2e/*.test.mjs",
    "test:e2e:stress": "node scripts/run-e2e.mjs --electron current --stress",
    "test:e2e:types": "tsc -p tsconfig.e2e.json",
    "test:types": "rslib build && tsc -p tsconfig.type-tests.json"
  },
  "license": "MIT",
  "homepage": "https://github.com/Sovea/electron-ipc-service#readme",
  "bugs": {
    "url": "https://github.com/Sovea/electron-ipc-service/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sovea/electron-ipc-service.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "dependencies": {
    "nanoid": "^5.1.5",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@playwright/test": "1.61.1",
    "@rslib/core": "^0.13.0",
    "@types/node": "^22.18.1",
    "electron": "28.0.0",
    "typescript": "^5.9.2",
    "vite": "8.1.5",
    "vite-plugin-electron": "1.1.0"
  },
  "peerDependencies": {
    "electron": ">=28.0.0"
  }
}
